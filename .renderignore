# Files Render should ignore when building the service image.
# .renderignore has the same syntax as .dockerignore.
# Why this matters: the repo is heavy (CSV reports, raw bhavcopies,
# model .joblib files, etc.) - but the dashboard only needs:
#   - web/                 (FastAPI app + static index.html)
#   - data/processed/nifty100_ohlcv.parquet  (5 MB)
#   - reports/live_signal.json              (15 KB)
# Everything else can be safely skipped to keep the slug small.

__pycache__
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
**/.pytest_cache

# The dashboard only imports from `web/main.py` and lazy-imports pandas
# inside the request handlers. The src/ training package and the .pyc
# caches are not needed at runtime.
src/
**/src/

# Local venvs / tool caches
.venv
venv
env
.mypy_cache
.ruff_cache
.coverage
htmlcov
.tox

# Heavy CSVs the dashboard does not read
data/raw
data/raw/**
data/external
data/external/**
data/interim
data/interim/**
data/live
data/live/**

# The 126 MB features parquet is not used by web/main.py
data/processed/nifty100_features.parquet
data/processed/nifty100_features.csv
data/processed/NIFTY50_features.csv
data/processed/NIFTY50_labels.csv
data/processed/predictions.csv
data/processed/nifty100_ohlcv.csv

# Training artefacts
models/
data/processed/*.joblib
data/processed/*.pkl

# All phase reports except the one the dashboard needs
reports/backtest_*
reports/ohlc_anomalies.csv
reports/data_snapshot.*
reports/feature_quality_report.md
reports/feature_schema.json
reports/NIFTY100_evaluation.*
reports/NIFTY50_evaluation.*
reports/phase1b_*
reports/phase1c_*
reports/phase2_*
reports/phase3_*
reports/phase4_*
reports/phase5_*
reports/phase6_*
reports/phase7_*
reports/phase8_*
reports/phase9_*
reports/xgboost_predictions.csv
reports/*.log
reports/*.err

# Generated by the live collector at runtime - do not bundle
# (block the whole scripts/ tree - dashboard never imports from it)
scripts/
scripts/**
scripts/setup_vps.sh
scripts/place_order.py
scripts/check_static_ip.py
scripts/fetch_*
scripts/build_*
scripts/train_*
scripts/phase*
scripts/enhanced_train.py
scripts/ensemble_train.py
scripts/xgb_tuning.py
scripts/xgboost_optimized.py
scripts/param_search.py
scripts/perf_diag.py
scripts/live_data_runner.py
scripts/refresh_live_features.py
scripts/run_nifty100_pipeline.py
scripts/predict_latest.py
scripts/audit_backtest.py
scripts/evaluate_model.py
scripts/evaluate_predictions.py
scripts/fast_phase1c.py
scripts/full_phase1c.py
scripts/test_baselines_quick.py
scripts/train_baselines.py

# Build/test artifacts
tests/
fix_indent.py
pytest.ini
pytest_last_run.txt

# Editor / OS
.git
.idea
.vscode
.DS_Store
Thumbs.db

# Environment files - never bundle secrets
.env
.env.*
!.env.example

# Keep these - they ARE what the dashboard needs:
#   - web/main.py
#   - web/static/index.html
#   - data/processed/nifty100_ohlcv.parquet
#   - reports/live_signal.json
#   - requirements-render.txt, render.yaml, Procfile, runtime.txt
