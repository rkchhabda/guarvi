# Groww API Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# Groww API Credentials (get from Groww Developer Portal)
GROWW_API_KEY=your_api_key_here
GROWW_SECRET=your_secret_key_here

# Static IP (must be whitelisted in Groww Developer Portal)
# Detect & save it automatically: python scripts/check_static_ip.py --set
GROWW_STATIC_IP=your_static_ip_here

# Access Token (optional - will be generated automatically from API key + secret)
# GROWW_ACCESS_TOKEN=your_access_token_here

# Optional: Override config file path
# DATA_CONFIG_PATH=config/data.yaml